# ── Auth backend environment (self-hosting only) ──────────────────────────────
#
# Most contributors do NOT need this file.
# The shared auth backend is already deployed. Set PLASMO_PUBLIC_AUTH_SERVER_URL
# in ui/.env.local and sign up normally — no backend setup required.
#
# Only fill in this file if you are running your own Convex deployment
# (e.g. to work on the auth backend itself).
# ──────────────────────────────────────────────────────────────────────────────

# Set automatically by `npx convex dev` — do not edit manually
CONVEX_DEPLOYMENT=dev:your-deployment-name
CONVEX_URL=https://your-deployment-name.convex.cloud

# Your Convex site URL — used by Better Auth as its base URL and for CORS
CONVEX_SITE_URL=https://your-deployment-name.convex.site

# Better Auth signing secret — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-better-auth-secret

# Google OAuth credentials — required for "Continue with Google"
# Create at https://console.cloud.google.com/ and add
# https://your-deployment-name.convex.site/api/auth/callback/google
# as an authorized redirect URI
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
