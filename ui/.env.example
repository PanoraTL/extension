# Your Google Gemini API key — used as a fallback when no authenticated session is present.
# Get one at https://aistudio.google.com/app/apikey
PLASMO_PUBLIC_GEMINI_API_KEY=your-gemini-api-key

# URL of your Better Auth + Convex auth server (see ui/auth/).
# Defaults to http://localhost:3000 if not set.
PLASMO_PUBLIC_AUTH_SERVER_URL=http://localhost:3000
