{
  "name": "panora-extension",
  "displayName": "Panora",
  "version": "0.8.0",
  "description": "Read any manga, in any language, instantly.",
  "author": "Rithvik",
  "license": "MIT",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "deploy": "npx convex deploy",
    "package": "plasmo package",
    "fix-icons": "node scripts/fix-icons.js"
  },
  "dependencies": {
    "@convex-dev/auth": "^0.0.90",
    "@convex-dev/better-auth": "^0.10.11",
    "@google/generative-ai": "^0.21.0",
    "better-auth": "1.4.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.31.7",
    "lucide-react": "^0.468.0",
    "plasmo": "^0.89.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.13.1",
    "sharp": "^0.32.6",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.4.0",
    "@plasmohq/parcel-resolver": "^0.14.2",
    "@types/chrome": "^0.0.278",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  },
  "manifest": {
    "host_permissions": [
      "https://*/*",
      "http://localhost:3000/*",
      "http://localhost:5001/*"
    ],
    "permissions": [
      "activeTab",
      "storage",
      "scripting",
      "tabs",
      "cookies",
      "clipboardRead",
      "clipboardWrite"
    ]
  }
}
